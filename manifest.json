{
  "manifest_version": 3,
  "name": "ChatGPT → Obsidian Export",
  "description": "Локальный протокол пар запрос–ответ для Obsidian, ссылки на сообщения, вложения и полный архив JSON.",
  "version": "0.3.9.1",
  "minimum_chrome_version": "100",
  "action": {
    "default_title": "Экспорт ChatGPT в Obsidian",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "zip.js",
        "renderer.js",
        "core.js",
        "reliability.js",
        "page.js",
        "dom-button.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
